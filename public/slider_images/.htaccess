# Disable script execution in upload directory
<FilesMatch "(?i)\.(php|php3|php4|php5|php7|php8|phtml|phar|phps|pl|py|cgi|asp|aspx|sh|bash|exe)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
